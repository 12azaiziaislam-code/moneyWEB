# ---------------------------------------------------------------------------
# Client build-time configuration (Vite). These values are PUBLIC.
# They end up inside the JS bundle — never put secrets here.
# Copy to `.env` (or set them in Cloudflare Pages > Settings > Environment variables)
# ---------------------------------------------------------------------------

VITE_FIREBASE_API_KEY=AIzaSy...your-public-web-api-key
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project
VITE_FIREBASE_APP_ID=1:1234567890:web:abcdef123456
VITE_FIREBASE_MESSAGING_SENDER_ID=1234567890
VITE_FIREBASE_STORAGE_BUCKET=your-project.appspot.com

# Shown in the UI (Profile > About)
VITE_APP_VERSION=1.0.0
